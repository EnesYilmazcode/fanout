# Generate both with: npm run secrets
# Mark both Sensitive in the Vercel dashboard. Use distinct values per environment.

# Signs Fanout API keys (HMAC-SHA256).
MASTER_SECRET=

# Seals provider connections (AES-256-GCM). Must decode to exactly 32 bytes.
MASTER_ENCRYPTION_KEY=

# Optional. Backs the supporter relay queue so users and supporters on different
# edge instances can find each other. Without these the queue is per-instance and
# in-memory — fine for a single-region demo. Create a free database at upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
